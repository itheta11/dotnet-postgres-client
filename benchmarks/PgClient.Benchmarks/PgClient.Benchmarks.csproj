<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PgClientBenchmarks</RootNamespace>
    <AssemblyName>PgClient.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <NoWarn>$(NoWarn);CA1001;CA2014;CA1707;CA1305;CA1861;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PgClient\PgClient.csproj" />
  </ItemGroup>

</Project>
